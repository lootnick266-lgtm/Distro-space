apiVersion: v1
kind: List
items:
{% if not distro_update_only %}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mysql-secret
      namespace: distro-space
      annotations:
        distro-credentials-hash: {{ distro_credentials_hash | to_json }}
    type: Opaque
    stringData:
      MYSQL_ROOT_PASSWORD: {{ distro_mysql_root_password | to_json }}
      MYSQL_DATABASE: {{ distro_db_name | to_json }}
      MYSQL_USER: {{ distro_db_user | to_json }}
      MYSQL_PASSWORD: {{ distro_mysql_app_password | to_json }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mysql-init
      namespace: distro-space
    type: Opaque
    stringData:
      001-schema.sql: |
        USE `{{ distro_db_name }}`;
{{ lookup('file', role_path + '/files/schema.sql') | indent(8, true) }}
        CREATE USER IF NOT EXISTS 'mysqld_exporter'@'%' IDENTIFIED BY '{{ distro_mysql_exporter_password }}' WITH MAX_USER_CONNECTIONS 3;
        GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'mysqld_exporter'@'%';
{% endif %}
{% if distro_registry_auth_enabled %}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: registry-credentials
      namespace: distro-space
    type: kubernetes.io/dockerconfigjson
    stringData:
      .dockerconfigjson: {{ {'auths': {distro_registry_server: {'username': distro_registry_username, 'password': distro_registry_token}}} | to_json | to_json }}
{% endif %}
{% if distro_vk_enabled and not distro_update_only %}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: vkbot-secret
      namespace: distro-space
    type: Opaque
    stringData:
      VKTOKEN: {{ distro_vk_token | to_json }}
      LOCAL_USER: {{ distro_vk_local_user | to_json }}
{% endif %}
