{% set route = lookup('file', distro_repo_root + '/k3s/monitoring/alertmanager-config.yml') | from_yaml %}
{% if not distro_telegram_enabled %}
{% set route = route | combine({'route': {'receiver': 'null', 'routes': []}, 'receivers': [{'name': 'null'}]}, recursive=true) %}
{% endif %}
apiVersion: v1
kind: List
items:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: distro-alertmanager-config
      namespace: monitoring
    type: Opaque
    stringData:
      alertmanager.yaml: {{ route | to_nice_yaml | to_json }}
{% if not distro_update_only %}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: mysql-exporter-credentials
      namespace: monitoring
    type: Opaque
    stringData:
      .my.cnf: |
        [client]
        user=mysqld_exporter
        password={{ distro_mysql_exporter_password }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: distro-grafana-admin
      namespace: monitoring
    type: Opaque
    stringData:
      admin-user: admin
      admin-password: {{ distro_grafana_admin_password | to_json }}
{% endif %}
