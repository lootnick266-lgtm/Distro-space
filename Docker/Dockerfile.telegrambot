FROM docker.io/library/golang:1.26.0-alpine AS build
WORKDIR /src
COPY telegrambot/go.mod telegrambot/TelegramAlertBot.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/telegrambot .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/telegrambot /telegrambot
EXPOSE 8080
ENTRYPOINT ["/telegrambot"]
